generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  name                   String?
  phoneNumber            String?
  image                  String?
  password               String?   // For username/password registration (hashed)
  authMethod             AuthMethod @default(GOOGLE) // GOOGLE or USERNAME_PASSWORD
  googleEmail            String?   // Store first Google email to prevent switching
  role                   Role      @default(RESIDENT)
  credibility            Float     @default(1.0)
  emailVerified          Boolean   @default(false)
  verificationToken      String?   @unique
  verificationTokenExpiry DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt @default(now())
  barangayId             String?
  barangay               Barangay? @relation(fields: [barangayId], references: [id])
  reports                Report[]
  resolvedReports        Report[]  @relation("ResolvedBy")
  notifications          Notification[]
  Session                Session[]
  severityKeywords       SeverityKeyword[]
  announcements          Announcement[]
}

model Report {
  id             String       @id @default(cuid())
  userId         String
  title          String
  description    String
  severity       Severity     @default(LOW)
  status         Status       @default(PENDING)
  category       String?
  address        String?      // Human-readable address from reverse geocoding
  latitude       Float?
  longitude      Float?
  createdAt      DateTime     @default(now())
  barangayId     String?
  resolvedById   String?
  resolvedAt     DateTime?
  assignedTo     String?      // Team member name for assignment
  deadline       DateTime?    // Planned resolution deadline
  resolutionNotes String?     // Notes when resolving
  remarks         String?     // General remarks from barangay officials
  isCredible     Boolean      @default(false)
  isFlagged      Boolean      @default(false)
  flagType       String?
  flagReason     String?
  fraudCheck     Json?
  flaggedAt      DateTime?
  multimedia     Multimedia[]
  notifications  Notification[]
  barangay       Barangay?    @relation(fields: [barangayId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  resolvedBy     User?        @relation("ResolvedBy", fields: [resolvedById], references: [id])
  severityDataset SeverityDataset?
}

model SeverityKeyword {
  id         String    @id @default(cuid())
  keyword    String    @unique
  severity   Severity
  addedById  String?
  addedBy    User?     @relation(fields: [addedById], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Multimedia {
  id        String    @id @default(cuid())
  reportId  String
  type      MediaType
  url       String
  analysis  Json?
  createdAt DateTime  @default(now())
  report    Report    @relation(fields: [reportId], references: [id])
}

model Barangay {
  id             String   @id @default(cuid())
  name             String
  latitude         Float
  longitude        Float
  address          String?
  boundaryPolygon  Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt @default(now())
  reports          Report[]
  officials        User[]
}

model Session {
  id               String    @id
  userId           String
  refreshTokenHash String    @unique
  deviceInfo       String?
  revoked          Boolean   @default(false)
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  User             User      @relation(fields: [userId], references: [id])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String    // STATUS_UPDATE, CREDIBILITY_UPDATE, NEW_REPORT
  read      Boolean   @default(false)
  reportId  String?
  report    Report?   @relation(fields: [reportId], references: [id])
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model SeverityDataset {
  id         String    @id @default(cuid())
  reportId   String    @unique
  report     Report    @relation(fields: [reportId], references: [id])
  source     String    @default("credible_severity_dataset")
  severity   Severity
  title      String
  description String
  address    String?
  barangayId String?
  analysis   Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Announcement {
  id              String    @id @default(cuid())
  title           String
  content         String
  priority        String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  targetAudience  String    @default("ALL") // ALL, RESIDENT, BARANGAY_OFFICIAL, ADMIN
  isActive        Boolean   @default(true)
  createdById     String?
  createdBy       User?     @relation(fields: [createdById], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model EmergencyNumber {
  id          String    @id @default(cuid())
  category    String    // e.g., "Police", "Fire", "Medical", "Barangay"
  number      String
  label       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum MediaType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
}

enum AuthMethod {
  GOOGLE
  USERNAME_PASSWORD
}

enum Severity {
  LOW
  MODERATE
  HIGH
}

enum Status {
  PENDING
  IN_PROGRESS
  RESOLVED
}

enum Role {
  RESIDENT
  BARANGAY_OFFICIAL
  ADMIN
}
